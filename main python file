# 7. MAIN EXECUTION PIPELINE
# ============================================================

if __name__ == "__main__":
    df = generate_complex_multivariate_ts()
    # FIX: Assign a datetime index to the DataFrame for Prophet
    df.index = pd.to_datetime(pd.date_range(start='2023-01-01', periods=len(df), freq='H'))
    print("Dataset shape:", df.shape)

    BACKCAST = 60
    FORECAST = 24

    ds = WindowDataset(df, BACKCAST, FORECAST)
    train_size = int(0.8 * len(ds))
    val_size = len(ds) - train_size
    train_dataset, val_dataset = torch.utils.data.random_split(ds, [train_size, val_size])

    train_loader = DataLoader(train_dataset, batch_size=32, shuffle=True)
    val_loader = DataLoader(val_dataset, batch_size=32, shuffle=False)

    device = "cuda" if torch.cuda.is_available() else "cpu"

    model = NBeats(backcast=BACKCAST, forecast=FORECAST, n_vars=3).to(device)
    model = train_model(model, train_loader, val_loader, epochs=10, lr=1e-3, device=device)

    # get a sample
    x_sample, y_sample = ds[100]
    contributions = decompose(model, x_sample.unsqueeze(0).to(device))

    print("Block forecast contributions extracted successfully.")

    # Benchmarks
    sarima_pred = benchmark_sarima(df['y'])
    prophet_pred = benchmark_prophet(df[['y']])
    print("Benchmarks finished.")
